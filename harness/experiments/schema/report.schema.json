{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "Experiment report",
  "description": "The one machine-readable report of one experiment run (Phase 8 spec, decision 14; sub-task 8.7): the source of truth every rendered table and paper number comes from. A header names the experiment, the spec's hash, the pins, the criterion, and the verdict; every section is an array of rows carrying the fields that locate each number (workload, condition, table, seed, boot default, aggregate). Scores and gaps are six-place decimal strings, provenance shares twelve-place, as in the files they come from; booleans are JSON booleans. The verdict is pass, fail, or invalid — invalid when a non-exempt guard failed on a run the criterion reads, named in verdict_detail.invalid_runs — and the per-file rows are computed and reported under every verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "spec_sha256", "pins", "conditions", "seed_count", "boot_defaults", "criterion",
               "verdict", "verdict_detail", "gaps", "scores", "provenance", "guards", "lines"],
  "$defs": {
    "identity": {
      "workload_id": {"type": "string", "minLength": 1},
      "condition": {"type": "string"},
      "table": {"type": "string"},
      "seed": {"type": "string"},
      "boot_default": {"type": "string"}
    },
    "six": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{6}$"},
    "twelve": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{12}$"},
    "verdict": {"enum": ["pass", "fail", "invalid"]},
    "count_verdict": {"oneOf": [{"enum": ["pass", "fail"]}, {"type": "null"}]},
    "run_ref": {"type": "object", "additionalProperties": false,
                "required": ["workload_id", "condition", "table", "seed", "boot_default", "guard"],
                "properties": {"workload_id": {"type": "string"}, "condition": {"type": "string"},
                               "table": {"type": "string"}, "seed": {"type": "string"},
                               "boot_default": {"type": "string"}, "guard": {"type": "string"}}}
  },
  "properties": {
    "experiment": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pins": {"type": "object"},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "seed_count": {"type": "integer", "minimum": 1},
    "boot_defaults": {"type": "object", "required": ["primary", "alternatives"]},
    "criterion": {"type": "object", "required": ["type"]},
    "verdict": {"$ref": "#/$defs/verdict"},
    "verdict_detail": {
      "type": "object", "additionalProperties": false, "required": ["met", "judging", "k", "invalid_runs"],
      "properties": {"met": {"type": "integer"}, "judging": {"type": "integer"}, "k": {"type": "integer"},
                     "invalid_runs": {"type": "array", "items": {"$ref": "#/$defs/run_ref"}}}},
    "gaps": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["workload_id", "judging", "boot_default", "reference_score", "compared_scores",
                             "compared_mean", "gap", "meets_g", "all_no_headroom", "n_no_headroom", "n_terms",
                             "random_beats_oracle", "available"],
                "properties": {
                  "workload_id": {"type": "string"}, "judging": {"type": "boolean"},
                  "boot_default": {"type": "string"},
                  "reference_score": {"$ref": "#/$defs/six"},
                  "compared_scores": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                      "required": ["seed", "score"],
                                      "properties": {"seed": {"type": "string"}, "score": {"$ref": "#/$defs/six"}}}},
                  "compared_mean": {"$ref": "#/$defs/six"}, "gap": {"$ref": "#/$defs/six"},
                  "meets_g": {"type": "boolean"}, "all_no_headroom": {"type": "boolean"},
                  "n_no_headroom": {"type": "integer"}, "n_terms": {"type": "integer"},
                  "random_beats_oracle": {"type": "boolean"},
                  "available": {"type": "boolean", "description": "no non-exempt guard failed on the runs this gap reads"}}}},
    "scores": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["workload_id", "condition", "table", "seed", "boot_default", "score", "weight_sum",
                             "n_terms", "n_no_headroom", "n_censored"],
                "properties": {"workload_id": {"type": "string"}, "condition": {"type": "string"},
                               "table": {"type": "string"}, "seed": {"type": "string"},
                               "boot_default": {"type": "string"},
                               "score": {"$ref": "#/$defs/six"}, "weight_sum": {"$ref": "#/$defs/six"},
                               "n_terms": {"type": "integer"}, "n_no_headroom": {"type": "integer"},
                               "n_censored": {"type": "integer"}}}},
    "provenance": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["workload_id", "condition", "table", "seed", "boot_default",
                             "time_share_unmodified", "time_share_clamped", "time_share_held",
                             "time_share_fallback", "fallback_share"],
                "properties": {"workload_id": {"type": "string"}, "condition": {"type": "string"},
                               "table": {"type": "string"}, "seed": {"type": "string"},
                               "boot_default": {"type": "string"},
                               "time_share_unmodified": {"$ref": "#/$defs/twelve"},
                               "time_share_clamped": {"$ref": "#/$defs/twelve"},
                               "time_share_held": {"$ref": "#/$defs/twelve"},
                               "time_share_fallback": {"$ref": "#/$defs/twelve"},
                               "fallback_share": {"$ref": "#/$defs/twelve"}}}},
    "guards": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["workload_id", "condition", "table", "seed", "boot_default", "guard", "result",
                             "value", "threshold", "partner", "reason", "exempt", "exemption_reason", "invalidating"],
                "properties": {"workload_id": {"type": "string"}, "condition": {"type": "string"},
                               "table": {"type": "string"}, "seed": {"type": "string"},
                               "boot_default": {"type": "string"}, "guard": {"type": "string"},
                               "result": {"enum": ["pass", "fail", "not_applicable"]},
                               "value": {"type": "string"}, "threshold": {"type": "string"},
                               "partner": {"type": "string"}, "reason": {"type": "string"},
                               "exempt": {"type": "boolean"}, "exemption_reason": {"type": "string"},
                               "invalidating": {"type": "boolean"}}}},
    "lines": {
      "type": "array",
      "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}}}
  }
}
